{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omnios",
  "main": "cloudflare/index.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "OmniOSContainer",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OMNIOS_CONTAINER",
        "class_name": "OmniOSContainer"
      }
    ]
  },
  "exports": {
    "OmniOSContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
